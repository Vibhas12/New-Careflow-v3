# Copy to api/.env and adjust. All settings use the CAREFLOW_ prefix.
CAREFLOW_ENV=development
# SQLite (default, zero install):
# CAREFLOW_DATABASE_URL=sqlite:///./careflow_dev.db
# PostgreSQL (see docker-compose.yml at the repo root):
# CAREFLOW_DATABASE_URL=postgresql+psycopg://careflow:careflow-dev@localhost:5432/careflow
CAREFLOW_COOKIE_SECURE=false        # true in production (HTTPS)
CAREFLOW_SESSION_HOURS=12
# Gemini recommendation agent (care-gap "Recommended next action"). Without a key the rule template is shown.
# CAREFLOW_GEMINI_API_KEY=your-google-ai-studio-key
# CAREFLOW_GEMINI_MODEL=gemini-3.5-flash
# CAREFLOW_GEMINI_FALLBACK_MODELS=["gemini-3.6-flash","gemini-3.5-flash-lite"]
# CAREFLOW_LLM_ENABLED=true
# AI agents (app/agents) – the LLM is only ever called when a person clicks an AI button.
# Kill switch (rollback level L1): false turns every agent off and hides stored AI output; restart the API after changing.
# CAREFLOW_AGENTS_ENABLED=true
# CAREFLOW_AGENTS_DISABLED=["recommendation"]          # switch off individual agents
# CAREFLOW_AGENT_CALLS_PER_USER_PER_HOUR=30
# CAREFLOW_AGENT_COOLDOWN_SECONDS=60                    # pause for everyone after a 429 on every model
